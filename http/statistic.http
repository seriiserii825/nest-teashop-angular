### Main statistic
# @name getMainStatistic
GET {{baseUrl}}/statistic/main/store/{{storeId}}
Authorization: Bearer {{accessToken}}

> {%
  client.test("main statistic ok", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body && typeof response.body.totalRevenue === "number", "expected totalRevenue in response body");
  });
%}

### Middle statistics
# @name getMiddleStatistics
GET {{baseUrl}}/statistic/middle/store/{{storeId}}
Authorization: Bearer {{accessToken}}

> {%
  client.test("middle statistics ok", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body && typeof response.body === "object", "expected an object in response body");
  });
%}
