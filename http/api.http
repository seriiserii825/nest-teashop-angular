### Register (run once, then use login below)
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "{{email}}",
  "password": "{{password}}"
}

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
  client.test("login succeeded", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
  });

  if (response.body && response.body.accessToken) {
    client.global.set("accessToken", response.body.accessToken);
    client.global.set("userId", response.body.user.id);
  }
%}

### Create store
# @name createStore
POST {{baseUrl}}/store
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "My Store",
  "description": "Test store created from kulala"
}

> {%
  client.test("store created", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
  });

  if (response.body && response.body.id) {
    client.global.set("storeId", response.body.id);
  }
%}

### Find all stores
# @name findAllStores
GET {{baseUrl}}/store
Authorization: Bearer {{accessToken}}

> {%
  client.test("stores list is not empty", function () {
    client.assert(Array.isArray(response.body), "expected an array in response body");
    client.assert(response.body.length > 0, "expected at least one store");
  });

  if (Array.isArray(response.body) && response.body.length > 0) {
    client.global.set("storeId", response.body[0].id);
  }
%}

### Find one store
GET {{baseUrl}}/store/{{storeId}}
Authorization: Bearer {{accessToken}}

### Create category
# @name createCategory
POST {{baseUrl}}/category/store/{{storeId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "Technology",
  "description": "Category for tech products"
}

> {%
  if (response.body && response.body.id) {
    client.global.set("categoryId", response.body.id);
  }
%}

### Find all categories for store
# @name findAllCategories
GET {{baseUrl}}/category/store/{{storeId}}
Authorization: Bearer {{accessToken}}

> {%
  if (Array.isArray(response.body) && response.body.length > 0) {
    client.global.set("categoryId", response.body[0].id);
  }
%}

### Create color
# @name createColor
POST {{baseUrl}}/color/store/{{storeId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Red",
  "value": "#ff0000"
}

> {%
  client.test("color created", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
  });

  if (response.body && response.body.id) {
    client.global.set("colorId", response.body.id);
  }
%}

### Find all colors for store
# @name findAllColors
GET {{baseUrl}}/color/store/{{storeId}}
Authorization: Bearer {{accessToken}}

> {%
  if (Array.isArray(response.body) && response.body.length > 0) {
    client.global.set("colorId", response.body[0].id);
  }
%}

### Get one color
GET {{baseUrl}}/color/store/{{storeId}}/color/{{colorId}}
Authorization: Bearer {{accessToken}}

### Update color
PATCH {{baseUrl}}/color/store/{{storeId}}/color/{{colorId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Dark Red",
  "value": "#8b0000"
}

### Delete color
DELETE {{baseUrl}}/color/store/{{storeId}}/color/{{colorId}}
Authorization: Bearer {{accessToken}}
